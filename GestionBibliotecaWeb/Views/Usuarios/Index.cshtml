@model IEnumerable<GestionBibliotecaWeb.Models.Usuario>

@{
    ViewData["Title"] = "Usuarios";
}

<div class="container mt-4">

    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb p-3 rounded shadow-sm bg-light">
        
            <li class="breadcrumb-item">
                <a href="/" class="text-dark text-decoration-none fw-semibold">
                    <i class="bi bi-house-door-fill"></i> Inicio
                </a>
            </li>

            <li class="breadcrumb-item active fw-bold text-primary" aria-current="page">
                <i class="bi bi-people-fill"></i> Usuarios
            </li>

        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h1 class="fw-bold">USUARIOS</h1>
            <h5 class="text-muted">Gestión de Usuarios</h5>
        </div>

        <a asp-action="Create" class="btn btn-primary shadow">
            <i class="bi bi-plus-circle"></i> Agregar Usuario
        </a>

    </div>

    <div class="card shadow rounded">

        <div class="card-body">

            <div style="max-height: 370px; overflow-y: auto;">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-dark sticky-top">
                        <tr>

                            <th>
                                Nombre
                            </th>

                            <th>
                                Rol
                            </th>

                            <th>
                                Estado
                            </th>

                            <th class="text-center">
                                Acciones
                            </th>

                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @Html.DisplayFor(modelItem => item.Nombre)
                                </td>

                                <!-- Mostrar nombre del Rol en lugar del Id -->
                                <td>
                                    @Html.DisplayFor(modelItem => item.Rol.Nombre)
                                </td>

                                <td>
                                    @if (item.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactivo</span>
                                    }
                                </td>

                                <td class="text-center">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.UsuarioId"
                                       class="btn btn-warning btn-sm rounded-circle shadow-sm">

                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <a asp-action="Details"
                                       asp-route-id="@item.UsuarioId"
                                       class="btn btn-info btn-sm rounded-circle shadow-sm">

                                        <i class="bi bi-file-earmark-text"></i>
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.UsuarioId"
                                       class="btn btn-danger btn-sm rounded-circle shadow-sm">

                                        <i class="bi bi-trash"></i>
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>