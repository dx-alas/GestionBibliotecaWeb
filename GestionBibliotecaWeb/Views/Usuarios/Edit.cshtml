@model GestionBibliotecaWeb.Models.Usuario

@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="container mt-4">

    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb p-3 rounded shadow-sm bg-light">
        
            <li class="breadcrumb-item">
                <a href="/" class="text-dark text-decoration-none fw-semibold">
                    <i class="bi bi-house-door-fill"></i> Inicio
                </a>
            </li>

            <li class="breadcrumb-item">
                <a href="/Usuarios" class="text-dark text-decoration-none fw-semibold">
                    <i class="bi bi-people-fill"></i> Usuarios
                </a>
            </li>

            <li class="breadcrumb-item active fw-bold text-warning" aria-current="page">
                <i class="bi bi-pencil-square"></i> Editar Usuario
            </li>

        </ol>
    </nav>

    <div class="card shadow-lg rounded">

        <div class="card-header bg-warning text-dark">
            <h3 class="mb-0">
                <i class="bi bi-pencil-square"></i>
                Editar Usuario
            </h3>
        </div>

        <div class="card-body">

            <form asp-action="Edit">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <input type="hidden" asp-for="UsuarioId" />

                <div class="mb-3">

                    <label class="form-label fw-bold">
                        Nombre
                    </label>

                    <input asp-for="Nombre"
                           class="form-control shadow-sm"
                           placeholder="Ingrese el nombre del usuario" />

                    <span asp-validation-for="Nombre"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label class="form-label fw-bold">
                        Nueva Contraseña
                    </label>

                    <input asp-for="Clave"
                           type="password"
                           value=""
                           class="form-control shadow-sm"
                           placeholder="Ingresar nueva clave" />

                    <span asp-validation-for="Clave"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label class="form-label fw-bold">
                        Rol
                    </label>

                    <select asp-for="RolId"
                            class="form-select shadow-sm"
                            asp-items="ViewBag.RolId">
                    </select>

                    <span asp-validation-for="RolId"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3 form-check">

                    <input class="form-check-input"
                           asp-for="Activo" />

                    <label class="form-check-label fw-bold">
                        Usuario Activo
                    </label>

                </div>

                <div class="d-flex gap-2">

                    <button type="submit" class="btn btn-success shadow">
                        <i class="bi bi-save"></i>
                        Guardar
                    </button>

                    <a asp-action="Index"
                           class="btn btn-warning shadow">

                        <i class="bi bi-arrow-left"></i>
                        Regresar
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}