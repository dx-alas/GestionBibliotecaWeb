@model GestionBibliotecaWeb.Models.Usuario

@{
    ViewData["Title"] = "Eliminar Usuario";
}

<div class="container mt-4">

    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb p-3 rounded shadow-sm bg-light">
    
            <li class="breadcrumb-item">
                <a href="/" class="text-dark text-decoration-none fw-semibold">
                    <i class="bi bi-house-door-fill"></i> Inicio
                </a>
            </li>

            <li class="breadcrumb-item">
                <a href="/Usuarios" class="text-dark text-decoration-none fw-semibold">
                    <i class="bi bi-people-fill"></i> Usuarios
                </a>
            </li>

            <li class="breadcrumb-item active fw-bold text-danger" aria-current="page">
                <i class="bi bi-trash-fill"></i> Eliminar Usuario
            </li>

        </ol>
    </nav>

    <div class="card shadow-lg rounded border-danger">

        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">
                <i class="bi bi-trash"></i>
                Eliminar Usuario
            </h3>
        </div>

        <div class="card-body">

            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle-fill"></i>
                ¿Está seguro que desea eliminar este usuario?
            </div>

            <div class="row mb-3">

                <div class="col-md-3 fw-bold">
                    Nombre
                </div>

                <div class="col-md-9">
                    @Html.DisplayFor(model => model.Nombre)
                </div>

            </div>

            <hr />

            <div class="row mb-3">

                <div class="col-md-3 fw-bold">
                    Estado
                </div>

                <div class="col-md-9">

                    @if (Model.Activo)
                    {
                        <span class="badge bg-success">
                            Activo
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            Inactivo
                        </span>
                    }

                </div>

            </div>

            <hr />

            <div class="row mb-4">

                <div class="col-md-3 fw-bold">
                    Rol
                </div>

                <div class="col-md-9">
                    @Html.DisplayFor(model => model.Rol.Nombre)
                </div>

            </div>

            <form asp-action="Delete">

                <input type="hidden" asp-for="UsuarioId" />

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-danger shadow">

                        <i class="bi bi-trash"></i>
                        Eliminar

                    </button>

                    <a asp-action="Index"
                           class="btn btn-secondary shadow">

                        <i class="bi bi-arrow-left"></i>
                        Regresar

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>