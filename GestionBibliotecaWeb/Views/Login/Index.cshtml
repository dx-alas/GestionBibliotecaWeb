@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body class="bg-dark">

    <div class="container-fluid vh-100">

        <div class="row h-100">

            <div class="col-lg-7 d-none d-lg-block p-0 position-relative">

                <img src="https://images.unsplash.com/photo-1507842217343-583bb7270b66?q=80&w=1600&auto=format&fit=crop" class="w-100 h-100 object-fit-cover" alt="Biblioteca" />
                <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-50"></div>

            </div>

            <!-- Formulario Login -->
            <div class="col-lg-5 col-12 d-flex justify-content-center align-items-center bg-white">

                <div class="w-75">
                    <!-- Header -->
                    <div class="mb-5">

                        <div class="mb-4 text-center">
                            <i class="bi bi-book-half display-1 text-dark"></i>
                        </div>

                        <h1 class="fw-bold text-center mb-3">Gestión Biblioteca</h1>
                        <p class="text-secondary text-center fs-5"> Administra préstamos, lectores y libros desde un solo lugar.</p>

                    </div>

                    <!-- Form -->
                    <form asp-action="Index" method="post">

                        @Html.AntiForgeryToken()

                        <!-- Usuario -->
                        <div class="form-floating mb-4">

                            <input type="text" name="nombre" class="form-control form-control-lg" id="usuario" placeholder="Usuario" required />
                            <label for="usuario"> Usuario</label>

                        </div>

                        <!-- Contraseña -->
                        <div class="form-floating mb-4">

                            <input type="password" name="clave" class="form-control form-control-lg" id="clave" placeholder="Contraseña" required />
                            <label for="clave">Contraseña</label>

                        </div>

                        <!-- Botón Iniciar Sesión-->
                        <div class="d-grid mb-4">

                            <button type="submit" class="btn btn-dark btn-lg py-3">
                                <i class="bi bi-box-arrow-in-right me-2"></i>
                                Iniciar sesión
                            </button>

                        </div>

                        <!-- Error -->
                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger text-center">@ViewBag.Error</div>
                        }

                    </form>

                    <!-- Footer -->
                    <div class="text-center mt-5 text-secondary small">
                        Sistema de Gestión Biblioteca © 2026
                    </div>

                </div>

            </div>

        </div>

    </div>

</body>
</html>