@model GestionBibliotecaWeb.Models.Autore

@{
    ViewData["Title"] = "Agregar Autor";
}

<div class="container mt-4">

    <!-- BREADCRUMB -->

    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb p-3 rounded shadow-sm bg-light">

            <li class="breadcrumb-item">
                <a href="/" class="text-dark text-decoration-none fw-semibold">
                    <i class="bi bi-house-door-fill"></i> Inicio
                </a>
            </li>

            <li class="breadcrumb-item">
                <a href="/Autores" class="text-dark text-decoration-none fw-semibold">
                    <i class="bi bi-people-fill"></i> Autores
                </a>
            </li>

            <li class="breadcrumb-item active fw-bold text-primary" aria-current="page">
                <i class="bi bi-plus-circle-fill"></i> Agregar Autor
            </li>

        </ol>
    </nav>

    <!-- TARJETA PRINCIPAL -->

    <div class="card shadow-lg rounded">

        <!-- ENCABEZADO -->

        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">
                <i class="bi bi-person-plus"></i>
                Agregar Autor
            </h3>
        </div>

        <!-- FORMULARIO -->

        <div class="card-body">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <!-- CAMPO NOMBRE -->

                <div class="mb-3">

                    <label class="form-label fw-bold">Nombre</label>

                    <input asp-for="Nombre"
                           class="form-control shadow-sm"
                           placeholder="Ingrese el nombre del autor" />

                    <span asp-validation-for="Nombre"
                          class="text-danger">
                    </span>

                </div>

                <!-- BOTONES -->


                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-success shadow">
                        <i class="bi bi-check-circle"></i>
                        Agregar
                    </button>

                    <a asp-action="Index"
                           class="btn btn-warning shadow">
                        <i class="bi bi-arrow-left"></i>
                        Regresar
                    </a>

                </div>
            </form>
        </div>
    </div>
</div>

<!-- SCRIPTS DE VALIDACION -->

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}