@model GestionBibliotecaWeb.Models.Prestamo

@{
    ViewData["Title"] = "Editar Prestamo";
}

<div class="container mt-4">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb p-3 rounded shadow-sm bg-light">

            <li class="breadcrumb-item">
                <a href="/" class="text-dark text-decoration-none fw-semibold">
                    <i class="bi bi-house-door-fill"></i> Inicio
                </a>
            </li>

            <li class="breadcrumb-item">
                <a href="/Prestamos" class="text-dark text-decoration-none fw-semibold">
                    <i class="bi bi-arrow-left-right"></i> Prestamos
                </a>
            </li>

            <li class="breadcrumb-item active fw-bold text-warning" aria-current="page">
                <i class="bi bi-pencil-square"></i> Editar Prestamo
            </li>

        </ol>
    </nav>

    <div class="card shadow-lg rounded">

        <!-- Header -->
        <div class="card-header bg-warning text-dark">
            <h3 class="mb-0">
                <i class="bi bi-pencil-square"></i>
                Editar Prestamo
            </h3>
        </div>

        <div class="card-body">

            <!-- Formulario -->
            <form asp-action="Edit">

                <div asp-validation-summary="ModelOnly" 
                    class="text-danger">
                </div>

                <!-- Id Oculto -->
                <input type="hidden" asp-for="PrestamoId" />
                
                <!-- Libro -->
                <div class="mb-3">

                    <label class="form-label fw-bold">Libro</label>

                    <select asp-for="LibroId" 
                        class="form-select shadow-sm"
                        asp-items="ViewBag.LibroId">
                    </select>

                    <span asp-validation-for="LibroId" 
                        class="text-danger">
                    </span>

                </div>

                <!-- Lector -->
                <div class="mb-3">

                    <label class="form-label fw-bol">Lector</label>

                    <select asp-for="LectorId" 
                        class="form-select shadow-sm"
                        asp-items="ViewBag.LectorId">
                    </select>

                    <span asp-validation-for="LectorId" 
                        class="text-danger">
                    </span>

                </div>

                <!-- Fecha Prestamo -->
                <div class="mb-3">
                    <label class="form-label fw-bol">Fecha Prestamo</label>

                    <input asp-for="FechaPrestamo" 
                           class="form-control shadow-sm"
                            placeholder="Ingrese la fecha de prestamo." />

                    <span asp-validation-for="FechaPrestamo" 
                        class="text-danger">
                    </span>

                </div>

                <!-- Fecha Devolución -->
                <div class="mb-3">
                    <label class="form-label fw-bol">Fecha Devolución</label>

                    <input asp-for="FechaDevolucion" 
                        class="form-control shadow-sm"
                        placeholder="Ingrese la fecha de devolución." />

                    <span asp-validation-for="FechaDevolucion" 
                        class="text-danger">
                    </span>

                </div>

                <!-- Observación -->
                <div class="mb-3">
                    <label class="form-label fw-bol">Observación</label>

                    <input asp-for="Observacion" 
                        class="form-control shadow-sm" 
                        placeholder="Ingrese una observación." />

                    <span asp-validation-for="Observacion" 
                        class="text-danger">
                    </span>
                </div>

                <!-- Usuario -->
                <div class="mb-3">
                    <label class="form-label fw-bol">Usuario</label>

                    <select asp-for="UsuarioId" 
                        class="form-select shadow-sm"
                        asp-items="ViewBag.UsuarioId">
                    </select>

                    <span asp-validation-for="UsuarioId" 
                        class="text-danger">
                    </span>

                </div>

                <!-- Botones -->
                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-success shadow">
                        <i class="bi bi-save"></i>
                        Guardar
                    </button>

                    <a asp-action="Index"
                           class="btn btn-warning shadow">
                        <i class="bi bi-arrow-left"></i>
                        Regresar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
