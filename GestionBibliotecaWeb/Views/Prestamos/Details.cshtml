@model GestionBibliotecaWeb.Models.Prestamo

@{
    ViewData["Title"] = "Detalle Prestamo";
}

<div class="container mt-4">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb p-3 rounded shadow-sm bg-light">

            <li class="breadcrumb-item">
                <a href="/" class="text-dark text-decoration-none fw-semibold">
                    <i class="bi bi-house-door-fill"></i> Inicio
                </a>
            </li>

            <li class="breadcrumb-item">
                <a href="/Prestamos" class="text-dark text-decoration-none fw-semibold">
                    <i class="bi bi-arrow-left-right"></i> Prestamos
                </a>
            </li>

            <li class="breadcrumb-item active fw-bold text-info" aria-current="page">
                <i class="bi bi-file-earmark-text-fill"></i> Detalles Prestamo
            </li>

        </ol>
    </nav>

    <div class="card shadow-lg rounded">

        <!-- Header -->
        <div class="card-header bg-info text-white">
            <h3 class="mb-0">
                <i class="bi bi-book"></i>
                Detalles del Prestamo
            </h3>
        </div>

        <div class="card-body">

            <!-- Fecha Prestamo -->
            <div class="row mb-3">

                <div class="col-md-3 fw-bold">
                    Fecha Prestamo
                </div>

                <div class="col-md-9">
                    @Html.DisplayFor(model => model.FechaPrestamo)
                </div>

            </div>

            <hr />

            <!-- Fecha Devolución -->
            <div class="row mb-3">

                <div class="col-md-3 fw-bold">
                    Fecha Devolución
                </div>

                <div class="col-md-9">
                    @Html.DisplayFor(model => model.FechaDevolucion)
                </div>

            </div>

            <hr />

            <!-- Observación -->
            <div class="row mb-3">

                <div class="col-md-3 fw-bold">
                    Fecha Observación
                </div>

                <div class="col-md-9">
                    @Html.DisplayFor(model => model.Observacion)
                </div>

            </div>

            <hr />

            <!-- Lector -->
            <div class="row mb-3">

                <div class="col-md-3 fw-bold">
                    Lector
                </div>

                <div class="col-md-9">
                    @Html.DisplayFor(model => model.Lector.Nombre)
                </div>

            </div>

            <hr />

            <!-- Libro -->
            <div class="row mb-3">

                <div class="col-md-3 fw-bold">
                    Libro
                </div>

                <div class="col-md-9">
                    @Html.DisplayFor(model => model.Libro.Titulo)
                </div>

            </div>

            <hr />

            <!-- Usuario -->
            <div class="row mb-3">

                <div class="col-md-3 fw-bold">
                    Usuario
                </div>

                <div class="col-md-9">
                    @Html.DisplayFor(model => model.Usuario.Nombre)
                </div>

            </div>

            <!-- Botón Regresar -->
            <div>
                <a asp-action="Index"
                    class="btn btn-warning shadow">
                    <i class="bi bi-arrow-left"></i>
                    Regresar
                </a>
            </div>
        </div>
    </div>
</div>
