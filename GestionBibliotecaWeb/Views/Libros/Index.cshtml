@model IEnumerable<GestionBibliotecaWeb.Models.Libro>

@{
    ViewData["Title"] = "Libros";
}

<div class="container mt-4">

    <!-- BREADCRUMB -->

    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb p-3 rounded shadow-sm bg-light">

            <li class="breadcrumb-item">
                <a href="/" class="text-dark text-decoration-none fw-semibold">
                    <i class="bi bi-house-door-fill"></i> Inicio
                </a>
            </li>

            <li class="breadcrumb-item active fw-bold text-primary" aria-current="page">
                <i class="bi bi-book-fill"></i> Libros
            </li>

        </ol>
    </nav>

    <!-- TITULO Y BOTON AGREGAR -->

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h1 class="fw-bold">LIBROS</h1>
            <h5 class="text-muted">Gestión de Libros</h5>
        </div>

        <a asp-action="Create" class="btn btn-primary shadow">
            <i class="bi bi-plus-circle"></i> Agregar Libro
        </a>

    </div>

    <!-- TABLA DE LIBROS -->

    <div class="card shadow rounded">

        <div class="card-body">

            <div style="max-height: 370px; overflow-y: auto;">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-dark sticky-top">
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.Titulo)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.ImagenUrl)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.Isbn)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.Autor)
                            </th>

                            <th class="text-center">
                                Acciones
                            </th>
                        </tr>
                    </thead>

                    <!-- FILAS DE LIBROS -->

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- TITULO -->

                                <td>
                                    @Html.DisplayFor(modelItem => item.Titulo)
                                </td>

                                <!-- IMAGEN -->

                                <td>
                                    @if (!string.IsNullOrEmpty(item.ImagenUrl))
                                    {
                                        <img src="@item.ImagenUrl"
                                             alt="Libro"
                                             style="width:50px; height:70px; object-fit:cover; border-radius:5px;" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin imagen</span>
                                    }
                                </td>

                                <td>
                                    @Html.DisplayFor(modelItem => item.Isbn)
                                </td>

                                <!-- Esto es para mostrar el nombre en lugar del Id-->
                                 <!-- AUTOR -->

                                <td>
                                    @Html.DisplayFor(modelItem => item.Autor.Nombre)
                                </td>

                                <!-- BOTONES DE ACCION -->

                                <td class="text-center">

                                    <a asp-action="Edit"
                                           asp-route-id="@item.LibroId"
                                           class="btn btn-warning btn-sm rounded-circle shadow-sm">

                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <a asp-action="Details"
                                           asp-route-id="@item.LibroId"
                                           class="btn btn-info btn-sm rounded-circle shadow-sm">

                                        <i class="bi bi-file-earmark-text"></i>
                                    </a>

                                    <a asp-action="Delete"
                                           asp-route-id="@item.LibroId"
                                           class="btn btn-danger btn-sm rounded-circle shadow-sm">

                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>