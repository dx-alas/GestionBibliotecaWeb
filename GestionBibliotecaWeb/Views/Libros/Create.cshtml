@model GestionBibliotecaWeb.Models.Libro

@{
    ViewData["Title"] = "Agregar Libro";
}

<div class="container mt-4">

    <!-- BREADCRUMB -->

    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb p-3 rounded shadow-sm bg-light">

            <li class="breadcrumb-item">
                <a href="/" class="text-dark text-decoration-none fw-semibold">
                    <i class="bi bi-house-door-fill"></i> Inicio
                </a>
            </li>

            <li class="breadcrumb-item">
                <a href="/Libros" class="text-dark text-decoration-none fw-semibold">
                    <i class="bi bi-book-fill"></i> Libros
                </a>
            </li>

            <li class="breadcrumb-item active fw-bold text-primary" aria-current="page">
                <i class="bi bi-plus-circle-fill"></i> Agregar Libro
            </li>

        </ol>
    </nav>

    <!-- TARJETA PRINCIPAL -->

    <div class="card shadow-lg rounded">

        <!-- ENCABEZADO -->

        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">
                <i class="bi bi-book"></i>
                Agregar Libro
            </h3>
        </div>

        <!-- FORMULARIO -->

        <div class="card-body">

            <form asp-action="Create" enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <!-- CAMPO TITULO -->

                <div class="mb-3">

                    <label class="form-label fw-bold">Titulo</label>

                    <input asp-for="Titulo"
                           class="form-control shadow-sm"
                           placeholder="Ingrese el título del libro" />

                    <span asp-validation-for="Titulo"
                          class="text-danger">
                    </span>

                </div>

                <!-- CAMPO IMAGEN -->

                <div class="mb-3">

                    <label class="form-label fw-bold">Imagen del Libro</label>

                    <input type="file"
                           name="imagenFile"
                           class="form-control shadow-sm"
                           accept="image/*" />

                    <span class="text-muted">
                        Seleccione una imagen desde su dispositivo
                    </span>

                </div>

                <!-- CAMPO AUTOR -->

                <div class="mb-3">

                    <!-- Revisar esto "AutorId se cambio por Autor y funcionó" -->
                    <label class="form-label fw-bold">Autor</label>

                    <select asp-for="AutorId"
                            class="form-select shadow-sm"
                            asp-items="ViewBag.AutorId">
                        <option selected disabled>
                            Seleccione un autor
                        </option>
                    </select>
                </div>

                <!-- CAMPO ISBN -->

                <div class="mb-3">
                    <!-- Revisar esto "Isbn se cambio por ISBN y NO funcionó" -->
                    <label class="form-label fw-bold">ISBN</label>

                    <input asp-for="Isbn"
                           class="form-control shadow-sm"
                           placeholder="Ingrese el ISBN" />

                    <span asp-validation-for="Isbn"
                          class="text-danger">
                    </span>

                </div>

                <!-- BOTONES -->

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-success shadow">
                        <i class="bi bi-check-circle"></i>
                        Agregar
                    </button>

                    <a asp-action="Index"
                        class="btn btn-warning shadow">
                        <i class="bi bi-arrow-left"></i>
                        Regresar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- SCRIPTS DE VALIDACION -->
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}