@model GestionBibliotecaWeb.Models.Libro

@{
    ViewData["Title"] = "Editar Libro";
}

<div class="container mt-4">

    <!-- BREADCRUMB -->

    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb p-3 rounded shadow-sm bg-light">

            <li class="breadcrumb-item">
                <a href="/" class="text-dark text-decoration-none fw-semibold">
                    <i class="bi bi-house-door-fill"></i> Inicio
                </a>
            </li>

            <li class="breadcrumb-item">
                <a href="/Libros" class="text-dark text-decoration-none fw-semibold">
                    <i class="bi bi-book-fill"></i> Libros
                </a>
            </li>

            <li class="breadcrumb-item active fw-bold text-warning" aria-current="page">
                <i class="bi bi-pencil-square"></i> Editar Libro
            </li>

        </ol>
    </nav>

    <!-- TARJETA PRINCIPAL -->

    <div class="card shadow-lg rounded">

        <!-- ENCABEZADO -->

        <div class="card-header bg-warning text-dark">
            <h3 class="mb-0">
                <i class="bi bi-pencil-square"></i>
                Editar Libro
            </h3>
        </div>

        <!-- FORMULARIO -->

        <div class="card-body">

            <form asp-action="Edit" enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <!-- CAMPO OCULTO ID -->

                <input type="hidden" asp-for="LibroId" />

                <!-- CAMPO TITULO -->

                <div class="mb-3">

                    <label class="form-label fw-bold">Titulo</label>

                    <input asp-for="Titulo"
                           class="form-control shadow-sm"
                           placeholder="Ingrese el título del libro" />

                    <span asp-validation-for="Titulo"
                          class="text-danger">
                    </span>

                </div>

                <!-- CAMPO IMAGEN -->

                <div class="mb-3">

                    <label class="form-label fw-bold">Cambiar Imagen del Libro</label>

                    <input type="hidden" asp-for="ImagenUrl" />

                    <input type="file"
                           name="imagenFile"
                           class="form-control shadow-sm"
                           accept="image/*" />

                    <span class="text-muted">
                        Si selecciona una nueva imagen, reemplazará la actual
                    </span>

                </div>

                <!-- CAMPO AUTOR -->

                <div class="mb-3">

                    <label class="form-label fw-bold">Autor</label>

                    <select asp-for="AutorId"
                            class="form-select shadow-sm"
                            asp-items="ViewBag.AutorId">
                    </select>

                    <span asp-validation-for="AutorId"
                          class="text-danger">
                    </span>

                </div>

                <!-- CAMPO ISBN -->

                <div class="mb-3">

                    <label class="form-label fw-bold">ISBN</label>

                    <input asp-for="Isbn"
                           class="form-control shadow-sm"
                           placeholder="Ingrese el ISBN" />

                    <span asp-validation-for="Isbn"
                          class="text-danger">
                    </span>

                </div>

                <!-- BOTONES -->

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-success shadow">
                        <i class="bi bi-save"></i>
                        Guardar
                    </button>

                    <a asp-action="Index"
                           class="btn btn-warning shadow">
                        <i class="bi bi-arrow-left"></i>
                        Regresar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- SCRIPTS DE VALIDACION -->

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}