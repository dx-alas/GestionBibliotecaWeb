<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GestionBibliotecaWeb</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GestionBibliotecaWeb.styles.css" asp-append-version="true" />
</head>
<body>
<header>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow fixed-top">

        <div class="container-fluid">

            <a class="navbar-brand fw-bold"
               asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-book-half"></i>
                Sistema Biblioteca
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#navbarContenido">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContenido">
                <ul class="navbar-nav ms-auto gap-2">

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door"></i>
                            Inicio
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Roles" asp-action="Index">
                            <i class="bi bi-person-badge"></i>
                            Roles
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Autores" asp-action="Index">
                            <i class="bi bi-pencil-square"></i>
                            Autores
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Lectores" asp-action="Index">
                            <i class="bi bi-people"></i>
                            Lectores
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Libros" asp-action="Index">
                            <i class="bi bi-book"></i>
                            Libros
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Prestamos" asp-action="Index">
                            <i class="bi bi-arrow-left-right"></i>
                            Prestamos
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Usuarios" asp-action="Index">
                            <i class="bi bi-person-circle"></i>
                            Usuarios
                        </a>
                    </li>
                        <li class="nav-item">
                            <a asp-controller="Login"
                                   asp-action="Logout"
                                   class="btn btn-outline-light">

                                <i class="bi bi-box-arrow-right"></i>
                                Cerrar sesión

                            </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

</header>
    <div class="container mt-5 pt-3">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @* <footer class="border-top footer text-muted">
        <div class="container">
            Aqui tenemos que poner tipo el dashboard de control - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer> *@


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
