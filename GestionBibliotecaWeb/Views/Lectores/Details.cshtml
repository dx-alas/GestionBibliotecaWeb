@model GestionBibliotecaWeb.Models.Lectore

@{
    ViewData["Title"] = "Detalles Lector";
}

<div class="container mt-4">

    <!-- BREADCRUMB -->

    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb p-3 rounded shadow-sm bg-light">

            <li class="breadcrumb-item">
                <a href="/" class="text-dark text-decoration-none fw-semibold">
                    <i class="bi bi-house-door-fill"></i> Inicio
                </a>
            </li>

            <li class="breadcrumb-item">
                <a href="/Lectores" class="text-dark text-decoration-none fw-semibold">
                    <i class="bi bi-people-fill"></i> Lectores
                </a>
            </li>

            <li class="breadcrumb-item active fw-bold text-info" aria-current="page">
                <i class="bi bi-person-circle"></i> Detalles Lector
            </li>

        </ol>
    </nav>

    <!-- TARJETA PRINCIPAL -->

    <div class="card shadow-lg rounded">

        <div class="card-header bg-info text-white">
            <h3 class="mb-0">
                <i class="bi bi-person-circle"></i>
                Detalles del Lector
            </h3>
        </div>

        <!-- CUERPO -->

        <div class="card-body">

            <!-- DATO NOMBRE -->

            <div class="row mb-3">

                <div class="col-md-3 fw-bold">
                    Nombre
                </div>

                <div class="col-md-9">
                    @Html.DisplayFor(model => model.Nombre)
                </div>

            </div>

            <hr />

            <!-- DATO APELLIDO -->

            <div class="row mb-3">

                <div class="col-md-3 fw-bold">
                    Apellido
                </div>

                <div class="col-md-9">
                    @Html.DisplayFor(model => model.Apellido)
                </div>

            </div>

            <hr />

            <!-- DATO DOCUMENTO -->

            <div class="row mb-3">

                <div class="col-md-3 fw-bold">
                    Documento
                </div>

                <div class="col-md-9">
                    @Html.DisplayFor(model => model.Documento)
                </div>

            </div>

            <hr />

            <!-- DATO CORREO -->

            <div class="row mb-3">

                <div class="col-md-3 fw-bold">
                    Correo
                </div>

                <div class="col-md-9">
                    @Html.DisplayFor(model => model.Correo)
                </div>

            </div>

            <hr />

            <!-- DATO TELEFONO -->

            <div class="row mb-3">

                <div class="col-md-3 fw-bold">
                    Telefono
                </div>

                <div class="col-md-9">
                    @Html.DisplayFor(model => model.Telefono)
                </div>

            </div>

            <!-- BOTONES -->

            <div class="mt-4 d-flex gap-2">

                <a asp-action="Edit"
                   asp-route-id="@Model.LectorId"
                   class="btn btn-warning shadow">

                    <i class="bi bi-pencil-square"></i>
                    Editar

                </a>

                <a asp-action="Index"
                   class="btn btn-secondary shadow">

                    <i class="bi bi-arrow-left"></i>
                    Regresar

                </a>

            </div>

        </div>

    </div>

</div>