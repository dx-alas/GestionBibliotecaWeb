@model GestionBibliotecaWeb.Models.Lectore

@{
    ViewData["Title"] = "Editar Lector";
}

<div class="container mt-4">

    <!-- BREADCRUMB -->

    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb p-3 rounded shadow-sm bg-light">

            <li class="breadcrumb-item">
                <a href="/" class="text-dark text-decoration-none fw-semibold">
                    <i class="bi bi-house-door-fill"></i> Inicio
                </a>
            </li>

            <li class="breadcrumb-item">
                <a href="/Lectores" class="text-dark text-decoration-none fw-semibold">
                    <i class="bi bi-people-fill"></i> Lectores
                </a>
            </li>

            <li class="breadcrumb-item active fw-bold text-warning" aria-current="page">
                <i class="bi bi-pencil-square"></i> Editar Lector
            </li>

        </ol>
    </nav>

    <!-- TARJETA PRINCIPAL -->

    <div class="card shadow-lg rounded">

        <!-- ENCABEZADO -->

        <div class="card-header bg-warning text-dark">
            <h3 class="mb-0">
                <i class="bi bi-pencil-square"></i>
                Editar Lector
            </h3>
        </div>

        <!-- FORMULARIO -->

        <div class="card-body">

            <form asp-action="Edit">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <!-- CAMPO OCULTO ID -->

                <input type="hidden" asp-for="LectorId" />

                <!-- CAMPO NOMBRE -->

                <div class="mb-3">

                    <label class="form-label fw-bold">
                        Nombre
                    </label>

                    <input asp-for="Nombre"
                           class="form-control shadow-sm"
                           placeholder="Ingrese el nombre del lector" />

                    <span asp-validation-for="Nombre"
                          class="text-danger">
                    </span>

                </div>

                <!-- CAMPO APELLIDO -->

                <div class="mb-3">

                    <label class="form-label fw-bold">
                        Apellido
                    </label>

                    <input asp-for="Apellido"
                           class="form-control shadow-sm"
                           placeholder="Ingrese el apellido del lector" />

                    <span asp-validation-for="Apellido"
                          class="text-danger">
                    </span>

                </div>

                <!-- CAMPO DOCUMENTO -->

                <div class="mb-3">

                    <label class="form-label fw-bold">
                        Documento
                    </label>

                    <input asp-for="Documento"
                           class="form-control shadow-sm"
                           placeholder="Ingrese el documento" maxlength="10"/>

                    <span asp-validation-for="Documento"
                          class="text-danger">
                    </span>

                </div>

                <!-- CAMPO CORREO -->

                <div class="mb-3">

                    <label class="form-label fw-bold">
                        Correo
                    </label>

                    <input asp-for="Correo"
                           class="form-control shadow-sm"
                           placeholder="Ingrese el correo" />

                    <span asp-validation-for="Correo"
                          class="text-danger">
                    </span>

                </div>

                <!-- CAMPO TELEFONO -->

                <div class="mb-3">

                    <label class="form-label fw-bold">
                        Telefono
                    </label>

                    <input asp-for="Telefono"
                           class="form-control shadow-sm"
                           placeholder="Ingrese el teléfono" maxlength="9"/>

                    <span asp-validation-for="Telefono"
                          class="text-danger">
                    </span>

                </div>

                <!-- BOTONES -->

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-success shadow">
                        <i class="bi bi-save"></i>
                        Guardar
                    </button>

                    <a asp-action="Index"
                       class="btn btn-warning shadow">

                        <i class="bi bi-arrow-left"></i>
                        Regresar

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

<!-- SCRIPTS DE VALIDACION -->

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}