@model GestionBibliotecaWeb.Models.Role

@{
    ViewData["Title"] = "Agregar Rol";
}

<div class="container mt-4">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb p-3 rounded shadow-sm bg-light">

            <li class="breadcrumb-item">
                <a href="/" class="text-dark text-decoration-none fw-semibold">
                    <i class="bi bi-house-door-fill"></i> Inicio
                </a>
            </li>

            <li class="breadcrumb-item">
                <a href="/Roles" class="text-dark text-decoration-none fw-semibold">
                    <i class="bi bi-shield-lock-fill"></i> Roles
                </a>
            </li>

            <li class="breadcrumb-item active fw-bold text-primary" aria-current="page">
                <i class="bi bi-plus-circle-fill"></i> Agregar Rol
            </li>

        </ol>
    </nav>

    <div class="card shadow-lg rounded">

        <!-- Header -->
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">
                <i class="bi bi-book"></i>
                Agregar Rol
            </h3>
        </div>

        <div class="card-body">
            <!-- Formulario -->
            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly" 
                    class="text-danger">
                </div>
            
                <!-- Campo Nombre -->
                <div class="mb-3">
                    <label asp-for="Nombre" class="control-label"></label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ingrese el nombre del rol" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <!-- Botones -->
                <div class="d-flex gap-2">
                    <!-- Botón Guardar -->
                    <button type="submit"
                            class="btn btn-success shadow">
                        <i class="bi bi-check-circle"></i>
                        Agregar
                    </button>

                    <!-- Botón Regresar -->
                    <a asp-action="Index"
                            class="btn btn-warning shadow">
                        <i class="bi bi-arrow-left"></i>
                        Regresar
                    </a>
                </div>

            </form>
        </div>

    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
