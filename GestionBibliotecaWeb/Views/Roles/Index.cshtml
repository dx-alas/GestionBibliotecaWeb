@model IEnumerable<GestionBibliotecaWeb.Models.Role>

@{
    ViewData["Title"] = "Roles";
}

<div class="container mt-4">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb p-3 rounded shadow-sm bg-light">

            <li class="breadcrumb-item">
                <a href="/" class="text-dark text-decoration-none fw-semibold">
                    <i class="bi bi-house-door-fill"></i> Inicio
                </a>
            </li>

            <li class="breadcrumb-item active fw-bold text-primary" aria-current="page">
                <i class="bi bi-shield-lock-fill"></i> Roles
            </li>

        </ol>
    </nav>

    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h1 class="fw-bold">Roles</h1>
            <h5 class="text-muted">Gestión de Roles</h5>
        </div>

        <a asp-action="Create" class="btn btn-primary shadow">
            <i class="bi bi-plus-circle"></i> Agregar Rol
        </a>

    </div>

    <!-- Tabla de Roles -->
    <div class="card shadow rounded">
        <div class="card-body">
            <div style="max-height: 370px; overflow-y: auto;">
                <table class="table table-hover align-middle mb-0">
                    <!-- Encabezado Tabla -->
                    <thead class="table-dark sticky-top">
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.Nombre)
                            </th>
                            <th>
                                Acciones
                            </th>
                        </tr>
                    </thead>
                    <!-- Cuerpo Tabla -->
                    <tbody>
                @foreach (var item in Model) {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Nombre)
                            </td>
                                <!-- Botones de Acciones -->
                            <td>
                                <!-- Botón Editar -->
                                <a asp-action="Edit" 
                                        asp-route-id="@item.RolId"
                                        class="btn btn-warning btn-sm rounded-circle shadow-sm">

                                    <i class="bi bi-pencil-square"></i>
                                </a>

                                <!-- Botón Detalles -->
                                <a asp-action="Details" 
                                        asp-route-id="@item.RolId"
                                        class="btn btn-info btn-sm rounded-circle shadow-sm">

                                    <i class="bi bi-file-earmark-text"></i>
                                </a>
                                <!-- Botón Eliminar -->
                                <a asp-action="Delete" 
                                        asp-route-id="@item.RolId"
                                        class="btn btn-danger btn-sm rounded-circle shadow-sm">

                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                }
                    </tbody>
            
                </table>
            </div>
        </div>
    </div>
</div>