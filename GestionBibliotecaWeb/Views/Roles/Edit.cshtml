@model GestionBibliotecaWeb.Models.Role

@{
    ViewData["Title"] = "Editar Rol";
}

<div class="container mt-4">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb p-3 rounded shadow-sm bg-light">

            <li class="breadcrumb-item">
                <a href="/" class="text-dark text-decoration-none fw-semibold">
                    <i class="bi bi-house-door-fill"></i> Inicio
                </a>
            </li>

            <li class="breadcrumb-item">
                <a href="/Roles" class="text-dark text-decoration-none fw-semibold">
                    <i class="bi bi-shield-lock-fill"></i> Roles
                </a>
            </li>

            <li class="breadcrumb-item active fw-bold text-warning" aria-current="page">
                <i class="bi bi-pencil-square"></i> Editar Rol
            </li>

        </ol>
    </nav>

    <div class="card shadow-lg rounded">

        <!-- Header -->
        <div class="card-header bg-warning text-dark">
            <h3 class="mb-0">
                <i class="bi bi-pencil-square"></i>
                Editar Rol
            </h3>
        </div>

        <div class="card-body">

            <!-- Formulario -->
            <form asp-action="Edit">

                <!-- Validaciones -->
                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <!-- Id oculto -->
                <input type="hidden" asp-for="RolId" />

                <!-- Campo Nombre -->
                <div class="mb-3">

                    <label class="form-label fw-bold">
                        Nombre del Rol
                    </label>

                    <input asp-for="Nombre"
                           class="form-control shadow-sm"
                           placeholder="Ingrese el nombre del rol" />

                    <span asp-validation-for="Nombre"
                          class="text-danger">
                    </span>

                </div>

                <!-- Botones -->
                <div class="d-flex gap-2">

                    <!-- Botón Guardar -->
                    <button type="submit"
                            class="btn btn-success shadow">
                        <i class="bi bi-save"></i>
                        Guardar
                    </button>

                    <!-- Botón Regresar -->
                    <a asp-action="Index"
                           class="btn btn-warning shadow">
                        <i class="bi bi-arrow-left"></i>
                        Regresar
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}